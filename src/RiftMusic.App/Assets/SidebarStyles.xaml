<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="CollectionButton" TargetType="Button">
    <Setter Property="Foreground" Value="#626262"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D6D1F0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#321BDD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SidebarModeToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#626262"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="28"/><Setter Property="MinWidth" Value="42"/><Setter Property="Padding" Value="7,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Mode" Background="Transparent" BorderBrush="#DAD7E3" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Mode" Property="Background" Value="#321BDD"/><Setter TargetName="Mode" Property="BorderBrush" Value="#321BDD"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Mode" Property="BorderBrush" Value="#321BDD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mode" Property="BorderBrush" Value="#181818"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="SidebarYearTemplate" TargetType="TreeViewItem"><ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/></ControlTemplate>
  <Style x:Key="SidebarItem" TargetType="TreeViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0,2"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
      <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
          <ToggleButton FocusVisualStyle="{x:Null}" x:Name="ExpandToggle" Grid.Column="1" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Width="32" Height="40" ToolTip="展开年份" AutomationProperties.Name="{Binding Name, StringFormat=展开或收起 {0}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ArrowTarget" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1"><TextBlock x:Name="ExpandArrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#8A8994" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform></TextBlock></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowTarget" Property="Background" Value="#EBE8F6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ArrowTarget" Property="BorderBrush" Value="#321BDD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
        </Grid>
        <Border x:Name="YearViewport" ClipToBounds="True" Height="0" Visibility="Collapsed" Margin="12,3,6,6">
          <StackPanel>
            <DockPanel Height="24" Margin="2,0,5,2"><Button x:Name="AllYearsButton" Content="全部年份" Tag="{Binding Id}" DockPanel.Dock="Right" FontSize="10" Padding="5,2" MinHeight="22" Background="Transparent" BorderThickness="0" Foreground="#626262" HorizontalAlignment="Right"/><TextBlock Text="年份" FontSize="10" Foreground="#92909B" VerticalAlignment="Center"/></DockPanel>
            <ScrollViewer MaxHeight="158" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsPresenter/></ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="ExpandToggle" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsYear}" Value="True"><Setter Property="Template" Value="{StaticResource SidebarYearTemplate}"/><Setter Property="Width" Value="60"/><Setter Property="Margin" Value="2,1"/></DataTrigger></Style.Triggers>
  </Style>
  <ControlTemplate x:Key="YearChipTemplate" TargetType="ToggleButton">
    <Border x:Name="Chip" MinHeight="28" Background="White" BorderBrush="#DFDDE7" BorderThickness="1" Padding="3,4" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#321BDD"/><Setter TargetName="Chip" Property="BorderBrush" Value="#321BDD"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#321BDD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#181818"/></Trigger><DataTrigger Binding="{Binding Count}" Value="0"><Setter Property="Opacity" Value="0.55"/></DataTrigger></ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="SidebarCheck" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#363440"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Row" MinHeight="40" Background="Transparent" Padding="10,7,4,7" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5"><DockPanel>
        <Border x:Name="Mark" Visibility="Collapsed" Width="14" Height="14" BorderThickness="1" BorderBrush="#A9A5B5" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"><Path UseLayoutRounding="False" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" x:Name="Tick" Data="M 0 4 L 3 7 L 9 0" Stroke="White" StrokeThickness="1.5" Width="8" Height="6" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
      </DockPanel></Border>
      <ControlTemplate.Triggers>
        <DataTrigger Binding="{Binding IsMultiple}" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></DataTrigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="#321BDD"/><Setter TargetName="Mark" Property="BorderBrush" Value="#321BDD"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Row" Property="Background" Value="#ECE9FC"/><Setter Property="Foreground" Value="#321BDD"/></Trigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Mark" Property="Background" Value="#321BDD"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Tick" Property="Data" Value="M 0 3 L 8 3"/><Setter TargetName="Row" Property="Background" Value="#ECE9FC"/><Setter Property="Foreground" Value="#321BDD"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#D6D1F0"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#321BDD"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsYear}" Value="True"><Setter Property="Template" Value="{StaticResource YearChipTemplate}"/></DataTrigger></Style.Triggers>
  </Style>
</ResourceDictionary>
