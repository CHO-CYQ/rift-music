<Window x:Class="RiftMusic.App.MusicDownloads" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="下载曲库 · 峡谷序曲" Width="740" Height="760" MinWidth="620" MinHeight="560" WindowStyle="None" WindowStartupLocation="CenterOwner">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Grid Background="{StaticResource CanvasBrush}">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="24,0,8,0"><TextBlock Text="音乐下载" FontSize="13" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="CloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="关闭音乐下载"/></Grid>
    <StackPanel Grid.Row="1" Margin="28,8,28,18"><TextBlock Text="BUILD YOUR LIBRARY" FontFamily="{DynamicResource WorldsDisplayFont}" FontWeight="Black" FontSize="38"/><TextBlock Text="只下载，你想听的" FontFamily="{DynamicResource ChineseDisplayFont}" FontWeight="Bold" FontSize="24" Margin="0,2,0,8"/><TextBlock Text="按分类选择曲包；下载后自动加入曲库，保留你的收藏与播放计划。" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="28,0,22,8">
      <ItemsControl x:Name="PackList"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,13" Margin="0,0,6,8">
          <CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" IsEnabled="{Binding Selectable}" Checked="SelectionChanged" Unchecked="SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Label}">
            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Pack.Name}" FontSize="16" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size}" FontFamily="{DynamicResource WorldsMonoFont}" Foreground="{StaticResource GoldBrush}" FontSize="13" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid>
          </CheckBox>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Background="White" Padding="28,16,28,22"><StackPanel>
      <TextBlock x:Name="SelectionLabel" Text="请选择需要的曲包" FontSize="14"/>
      <ProgressBar x:Name="TransferProgress" Height="5" Maximum="1" Margin="0,12,0,9" Foreground="{StaticResource GoldBrush}"/>
      <TextBlock x:Name="StatusLabel" Text="也可以在发布页下载曲包 ZIP，再点“导入曲包”。" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MinHeight="36"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="ImportPackButton" Content="导入曲包" Click="ImportClick" Style="{StaticResource QuietButton}" Padding="10,8"/>
        <Button Grid.Column="1" Content="发布页 ↗" Click="ReleaseClick" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Padding="10,8"/>
        <Button Grid.Column="3" x:Name="CancelButton" Content="取消下载" Click="CancelClick" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="0,0,12,0" Padding="10,8"/>
        <Button Grid.Column="4" x:Name="DownloadButton" Content="下载所选" Click="DownloadClick" Background="{StaticResource GoldBrush}" Foreground="White" Padding="22,10" IsEnabled="False"/>
      </Grid>
    </StackPanel></Border>
  </Grid>
</Window>
